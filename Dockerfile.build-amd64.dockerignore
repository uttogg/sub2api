# Dedicated context for Dockerfile.build-amd64. Deny everything by default.
**
!Dockerfile.build-amd64
!Dockerfile.build-amd64.dockerignore
!frontend/
frontend/*
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/index.html
!frontend/vite.config.ts
!frontend/postcss.config.js
!frontend/tailwind.config.js
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/src/
!frontend/src/**
!frontend/public/
frontend/public/*
!frontend/public/logo.svg
!docs/
docs/*
!docs/legal/
docs/legal/*
!docs/legal/admin-compliance.zh.md
!docs/legal/admin-compliance.en.md
!backend/
backend/*
!backend/go.mod
!backend/go.sum
!backend/cmd/
backend/cmd/*
!backend/cmd/server/
!backend/cmd/server/**
!backend/ent/
!backend/ent/**
!backend/internal/
!backend/internal/**
!backend/pkg/
!backend/pkg/**
!backend/migrations/
backend/migrations/*
!backend/migrations/*.go
!backend/migrations/*.sql
!backend/resources/
backend/resources/*
!backend/resources/model-pricing/
backend/resources/model-pricing/*
!backend/resources/model-pricing/model_prices_and_context_window.json
!deploy/
deploy/*
!deploy/docker-entrypoint.sh

# Re-exclude credentials, local plugins, tests and unused local/build material.
**/.git
**/.env
**/.env.*
**/.npmrc
**/.pnpmfile.cjs
**/.yarnrc*
**/.ssh
**/.aws
**/.codex
**/.agents
**/credentials
**/credentials.*
**/secrets
**/secrets.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
/plugins/
**/*_test.go
**/*.test.*
**/*.spec.*
**/__tests__
**/test
**/tests
**/testdata
**/testutil
**/enttest
**/fixtures
**/__fixtures__
**/node_modules
**/vendor
**/dist
**/coverage
**/.cache
**/*.log
**/*.tmp
**/config.yaml
**/config.local.yaml
frontend/**/*.md
backend/**/*.md
